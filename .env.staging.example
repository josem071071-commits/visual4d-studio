# Sprint 4.1 staging only — never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
VISUAL4D_LOCAL_AUTH_TOKEN=replace-with-staging-secret
VISUAL4D_LOCAL_USER_ID=staging-user
VISUAL4D_ALLOW_DEV_APPROVAL_GRANTS=false
VISUAL4D_MCP_HOST=0.0.0.0
# Railway injects PORT automatically. For local Docker use 8787.
PORT=8787
VISUAL4D_MAX_BODY_BYTES=65536
VISUAL4D_REQUEST_TIMEOUT_MS=10000
VISUAL4D_RATE_LIMIT_PER_MINUTE=120
