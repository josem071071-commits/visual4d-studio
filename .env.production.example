# Visual 4D Studio — production OAuth/OIDC contract
# Never put real secrets or production credentials in this file.
NODE_ENV=production
PORT=8787
VISUAL4D_MCP_HOST=0.0.0.0
VISUAL4D_ALLOW_DEV_APPROVAL_GRANTS=false

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Public canonical MCP resource. Must be HTTPS and identify the MCP path.
VISUAL4D_MCP_RESOURCE_URI=https://api.visual4d.example/mcp

# Identity provider.
VISUAL4D_OIDC_ISSUER=https://identity.example.com/
VISUAL4D_OIDC_AUDIENCE=visual4d-mcp

# Normally omitted: jwks_uri is discovered from the issuer.
# VISUAL4D_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# VISUAL4D_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration

VISUAL4D_RATE_LIMIT_PER_MINUTE=120

# IMPORTANT: VISUAL4D_AUTH_TOKEN is staging-only and MUST NOT exist in production.
