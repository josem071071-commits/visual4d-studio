{
  "name": "visual4d-prototype",
  "version": "0.9.0-rc.1",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:core": "node --test tests/runtime/core.test.mjs",
    "build:core": "tsc -p tsconfig.core.json",
    "clean": "rm -rf dist",
    "test:migrations": "node --test tests/runtime/migration-contract.test.mjs",
    "test": "npm run build:core && npm run typecheck && npm run test:core && npm run test:sprint2 && npm run test:sprint2.1 && npm run test:sprint2.2 && npm run test:sprint2.3 && npm run test:sprint3 && npm run test:sprint3.1 && npm run test:sprint3.2 && npm run test:sprint3.3 && npm run test:sprint3.4 && npm run build:integration && npm run test:sprint3.5 && npm run test:sprint4.3 && npm run test:sprint4.5 && npm run test:sprint4.6 && npm run test:migrations",
    "test:postgres-migration": "node --test tests/integration/postgres-migration.test.mjs",
    "test:sprint2": "node --test tests/runtime/sprint2-workflow.test.mjs",
    "test:sprint2.1": "node --test tests/runtime/sprint2_1_contract.test.mjs",
    "build:integration": "tsc -p tsconfig.integration.json",
    "test:integration:postgres": "npm run build:integration && node --test tests/integration/postgres-repository.integration.test.mjs",
    "test:integration:mcp": "npm run build:integration && node --test tests/integration/mcp-local.integration.test.mjs",
    "test:sprint2.2": "node --test tests/runtime/sprint2_2_contract.test.mjs",
    "start:mcp:local": "node dist-integration/services/mcp-server/src/local-server.js",
    "start:mcp:production": "node dist-integration/services/mcp-server/src/ensure-production-schema.js && node dist-integration/services/mcp-server/src/production-server.js",
    "test:sprint2.3": "node --test tests/runtime/sprint2_3_certification.test.mjs",
    "test:sprint3": "node --test tests/runtime/sprint3_layout.test.mjs",
    "test:sprint3.1": "node --test tests/runtime/sprint3_1_renderer.test.mjs",
    "test:sprint3.2": "node --test tests/runtime/sprint3_2_asset_binding.test.mjs",
    "test:sprint3.3": "node --test tests/runtime/sprint3_3_identity_style.test.mjs",
    "test:sprint3.4": "node --test tests/runtime/sprint3_4_render_service.test.mjs",
    "test:sprint3.5": "node --test tests/runtime/sprint3_5_render_mcp_contract.test.mjs",
    "test:sprint4.3": "node --test tests/runtime/sprint4_3_apps_sdk_contract.test.mjs",
    "test:sprint4.5": "node --test tests/integration/production-jwt.test.mjs",
    "test:sprint4.6": "npm run build:integration && node --test dist-integration/tests/production-server.test.js dist-integration/tests/oidc-discovery.test.js",
    "render:sprint3.1:sample": "node scripts/render-sprint3-sample.mjs",
    "render:sprint3.2:sample": "node scripts/render-sprint3_2-sample.mjs",
    "render:sprint3.3:sample": "node scripts/render-sprint3_3-sample.mjs",
    "render:sprint3.4:sample": "node scripts/render-sprint3_4-sample.mjs",
    "test:certification:postgres": "npm run build:integration && node --test tests/integration/core-certification.integration.test.mjs",
    "test:certification": "npm run build:core && npm run typecheck && npm run test:core && npm run test:sprint2 && npm run test:sprint2.1 && npm run test:sprint2.2 && npm run test:sprint2.3 && npm run test:sprint3 && npm run test:sprint3.1 && npm run test:sprint3.2 && npm run test:sprint3.3 && npm run test:sprint3.4 && npm run build:integration && npm run test:sprint3.5 && npm run test:sprint4.3 && npm run test:sprint4.5 && npm run test:sprint4.6 && npm run test:migrations && npm run test:certification:postgres",
    "test:ci:postgres-migration": "node scripts/run-test-no-skip.mjs tests/integration/postgres-migration.test.mjs",
    "test:ci:core-certification": "node scripts/run-test-no-skip.mjs tests/integration/core-certification.integration.test.mjs",
    "test:ci:all-tools-certification": "node scripts/run-test-no-skip.mjs tests/integration/all-tools-certification.integration.test.mjs",
    "certify:report": "node scripts/generate-certification-report.mjs",
    "validate:publication": "node scripts/validate-publication-package.mjs"
  },
  "dependencies": {
    "zod": "4.4.3",
    "pg": "8.23.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "typescript": "5.8.3",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {"node": ">=22.0.0"}
}
